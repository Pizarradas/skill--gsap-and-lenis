      ],
      "correccion": "Quita scroll-snap-type y usa lenis/snap.",
      "evidencia": "cmb-snap",
      "detecta": [
        {
          "archivos": "js|css|html",
          "todos": [
            "@lenis",
            "(?m)(?:^|[\\s,}>;])(?:html|body|:root)(?:\\.[\\w-]+)*\\s*(?:,[^{}]*)?\\{[^}]*scroll-snap-type\\s*:[^;}]*mandatory"
          ],
          "ninguno": []
