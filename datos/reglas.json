            "scrollTrigger\\s*:|ScrollTrigger\\.create"
          ],
          "ninguno": [
            "ScrollTrigger\\.update"
          ]
        }
      ]
    },
    {
      "id": "O05",
      "titulo": "lenis.raf recibe segundos",
      "severidad": "bloqueante",
      "perfiles": [
        "gsap+lenis"
      ],
      "correccion": "Multiplica por 1000: lenis.raf(time * 1000).",
      "evidencia": "cmb-reloj",
      "detecta": [
        {
          "archivos": "js",
          "todos": [
            "ticker\\.add\\(\\s*(?:async\\s+)?(?:function\\b[^(]*)?\\(?\\s*(\\w+)\\b[^)=]*\\)?\\s*(?:=>)?\\s*\\{?[\\s\\S]{0,200}?\\.raf\\(\\s*\\1\\s*\\)"
          ],
          "ninguno": []
        },
        {
          "archivos": "js",
          "todos": [
            "(?:(?:const|let|var)\\s+(\\w+)\\s*=\\s*(?:async\\s+)?(?:function\\b[^(]*)?\\(?\\s*(\\w+)\\b[^)=]*\\)?\\s*(?:=>)?\\s*\\{?|function\\s+(\\w+)\\s*\\(\\s*(\\w+)\\b[^)]*\\)\\s*\\{)[\\s\\S]{0,200}?\\.raf\\(\\s*(?:\\2|\\4)\\s*\\)[\\s\\S]*?ticker\\.add\\(\\s*(?:\\1|\\3)\\s*[,)]"
          ],
          "ninguno": []
        }
      ]
    },
    {
