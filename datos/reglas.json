    },
    {
      "id": "O12",
      "titulo": "ScrollTrigger sin scroller con Lenis en contenedor",
      "severidad": "aviso",
      "perfiles": [
        "gsap+lenis"
      ],
      "correccion": "Pasa scroller a cada instancia, o ScrollTrigger.defaults({ scroller }) antes de crearlas.",
      "evidencia": "cmb-contenedor",
      "detecta": [
        {
          "archivos": "js",
          "todos": [
