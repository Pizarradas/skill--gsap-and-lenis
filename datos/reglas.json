{
  "reglas": [
    {
      "id": "O01",
      "titulo": "autoRaf y gsap.ticker a la vez",
      "severidad": "bloqueante",
      "perfiles": [
        "gsap+lenis"
      ],
      "correccion": "Quita autoRaf: true y deja gsap.ticker.add((t) => lenis.raf(t * 1000)).",
      "evidencia": "cmb-reloj",
      "detecta": [
        {
          "archivos": "js",
          "todos": [
            "autoRaf\\s*:\\s*true",
            "ticker\\.add",
            "\\.raf\\("
          ],
          "ninguno": []
        },
        {
          "archivos": "js",
          "todos": [
            "<(?:ReactLenis|VueLenis|vue-lenis)\\b",
            "ticker\\.add",
            "\\.raf\\("
          ],
          "ninguno": [
            "autoRaf\\s*:\\s*false",
            "autoRaf=\\{false\\}",
            "auto-raf=[\"']false"
          ]
        }
      ]
    },
    {
      "id": "O02",
      "titulo": "Dos instancias de Lenis sobre la misma raíz",
      "severidad": "bloqueante",
      "perfiles": [
        "lenis",
        "gsap+lenis"
      ],
      "correccion": "Destruye la anterior antes de crear otra. Comprobación en ejecución: el análisis estático no distingue ventana de contenedor.",
      "evidencia": "cmb-salida",
      "detecta": []
    },
    {
      "id": "O03",
      "titulo": "ScrollSmoother y Lenis juntos",
      "severidad": "bloqueante",
      "perfiles": [
        "gsap+lenis",
        "gsap-smoother"
      ],
      "correccion": "Elige uno con cmb-smoother y retira el otro, incluidas sus clases.",
      "evidencia": "cmb-smoother",
      "detecta": [
        {
          "archivos": "js",
          "todos": [
            "ScrollSmoother\\.create|new ScrollSmoother\\(|\\bperfil\\s*:\\s*[\"\\'`]gsap-smoother[\"\\'`]",
            "new Lenis\\b|ReactLenis|VueLenis|useLenis|\\bperfil\\s*:\\s*[\"\\'`](?:gsap\\+)?lenis[\"\\'`]"
          ],
          "ninguno": []
        }
      ]
    },
    {
      "id": "O04",
      "titulo": "Falta lenis.on('scroll', ScrollTrigger.update)",
      "severidad": "bloqueante",
      "perfiles": [
        "gsap+lenis"
      ],
      "correccion": "Añade lenis.on('scroll', ScrollTrigger.update) al crear la instancia.",
      "evidencia": "cmb-reloj",
      "detecta": [
        {
          "archivos": "js",
          "todos": [
