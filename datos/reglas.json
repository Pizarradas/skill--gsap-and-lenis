    {
      "id": "O08",
      "titulo": "Mover el scroll sin pasar por Lenis",
      "severidad": "bloqueante",
      "perfiles": [
        "lenis",
        "gsap+lenis"
      ],
      "correccion": "Usa lenis.scrollTo; toma el destino de st.start, st.end o labelToScroll. La detección no cubre st.scroll() ni window.scrollTo, que fallan igual.",
      "evidencia": "cmb-scroll-programatico",
      "detecta": [
        {
          "archivos": "js",
          "todos": [
            "@lenis",
            "\\.(?:to|fromTo)\\(\\s*(?:window|document(?:\\.(?:documentElement|body|scrollingElement))?|[\"'`](?:html|body)[\"'`])\\s*,\\s*(?:\\{[^{}]*\\}\\s*,\\s*)?\\{[^}]*\\bscrollTo\\b\\s*[:,}]"
          ],
          "ninguno": [
            "\\bwrapper\\s*:(?!\\s*window\\b)|new Lenis\\(\\s*\\{[^}]*\\bwrapper\\b(?!\\s*:\\s*window\\b)",
            "\\braiz\\s*:(?!\\s*window\\b)"
          ]
        },
        {
          "archivos": "js",
          "todos": [
            "@lenis",
            "(?<!\\btl)(?<!\\btimeline)\\.tweenTo\\(|\\b(?:scrollTrigger|st)\\.scroll\\(\\s*[^)\\s]"
          ],
          "ninguno": []
        },
        {
          "archivos": "js",
          "todos": [
            "@lenis",
            "\\bwindow\\.scroll(?:To|By)?\\(|\\bdocument\\.documentElement\\.scrollTop\\s*=(?!=)"
          ],
          "ninguno": [
            "\\bwrapper\\s*:(?!\\s*window\\b)|new Lenis\\(\\s*\\{[^}]*\\bwrapper\\b(?!\\s*:\\s*window\\b)",
            "\\braiz\\s*:(?!\\s*window\\b)"
          ],
          "salvo_tras": "\\.destroy\\(\\)",
          "salvo_antes": "new Lenis\\b|iniciarMovimiento\\("
        },
        {
          "archivos": "js",
          "todos": [
            "@lenis",
            "\\.(?:to|fromTo)\\(\\s*(?!(?:window|document(?:\\.(?:documentElement|body|scrollingElement))?|[\"'`](?:html|body)[\"'`])\\s*,)[^,]+\\s*,\\s*(?:\\{[^{}]*\\}\\s*,\\s*)?\\{[^}]*\\bscrollTo\\b\\s*[:,}]"
          ],
          "ninguno": [
            "data-lenis-prevent"
          ],
          "severidad": "aviso",
          "nota": "ScrollToPlugin sobre otro destino: solo es la excepción de orq-propiedad si es un área con data-lenis-prevent, y si no es el contenedor de Lenis."
        }
      ]
    },
    {
      "id": "O09",
      "titulo": "snap de ScrollTrigger con Lenis sin delay suficiente",
      "severidad": "aviso",
      "perfiles": [
        "gsap+lenis"
