      "severidad": "aviso",
      "perfiles": [
        "gsap+lenis"
      ],
      "correccion": "Quítalo: tras un bloqueo largo salta. Solo se justifica con audio o vídeo; si lo usas, restaura 500, 33 al salir.",
      "evidencia": "cmb-reloj",
      "detecta": [
        {
          "archivos": "js",
          "todos": [
